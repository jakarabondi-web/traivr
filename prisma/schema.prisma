// Disputes, support, notifications
// ---------------------------------------------------------------------------

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_APPROVED
  RESOLVED_DENIED
  APPEALED
}

model Dispute {
  id          String        @id @default(uuid())
  userId      String
  projectId   String?
  taskIds     String[]      @default([])
  amountCents Int?
  reason      String
  status      DisputeStatus @default(OPEN)
  decision    String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disputes")
}

enum TicketCategory {
  ACCOUNT
  ASSESSMENT
  PROJECT_ACCESS
  TASK_ISSUE
  QUALITY_APPEAL
  PAYMENT
  TECHNICAL_ISSUE
  SAFETY_CONCERN
  DATA_PRIVACY
  OTHER
}

enum TicketStatus {
  OPEN
  ASSIGNED
  WAITING_FOR_TRAINER
  WAITING_FOR_CLIENT
  ESCALATED
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String         @id @default(uuid())
  requesterId String
  assigneeId  String?
  category    TicketCategory
  subject     String
  status      TicketStatus   @default(OPEN)
  /// True when opened by the support-signals scan rather than the trainer
  /// themselves — `requesterId` still names the trainer the ticket is about,
  /// since the schema has no system/service-account user to attribute it to.
  autoGenerated Boolean      @default(false)
  /// Which detector opened this (e.g. "stalled_application",
  /// "quality_drop", "payout_failures") — null for self-reported tickets.
  /// Lets a rerun of the scan recognise "already flagged for this" without
  /// parsing the subject line.
  signal      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  requester User             @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee  User?            @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages  SupportMessage[]

  @@index([requesterId, signal, status])
  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

