  submittedAt DateTime @default(now())

  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  versions    SubmissionVersion[]
  reviews     Review[]
  adjudication Adjudication?
  appeals     QualityAppeal[]

  @@index([taskId])
  @@map("task_submissions")
}

model SubmissionVersion {
  id           String   @id @default(uuid())
  submissionId String
  content      Json
  createdAt    DateTime @default(now())

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_versions")
}

model GoldTask {
  id             String @id @default(uuid())
  taskId         String @unique
  projectId      String
  expectedAnswer Json

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results GoldTaskResult[]

  @@map("gold_tasks")
}

// ---------------------------------------------------------------------------
// Review & quality
// ---------------------------------------------------------------------------

enum ReviewDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
  ESCALATED
}

/// A project's scoring rubric.
///
/// Rubrics are versioned rather than edited in place: scores already
/// recorded were given against a specific wording, and silently changing
/// that wording would make historical scores incomparable. Editing creates
/// a new version and deactivates the old one.
model ReviewRubric {
  id        String   @id @default(uuid())
  projectId String
  name      String
  /// Array of { key, label, description, weight } — see lib/tasks/rubric.ts.
  criteria  Json
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scores  ReviewScore[]

  @@index([projectId, isActive])
  @@map("review_rubrics")
}

enum AdjudicationStatus {
  PENDING
  RESOLVED
}

/// A lead reviewer's final call on a submission that reviewers disagreed on
/// or that a reviewer escalated.
///
/// Adjudication is the top of the quality chain — nothing above it is
/// automated, per the platform rule that serious decisions need a person.
model Adjudication {
  id            String             @id @default(uuid())
  submissionId  String             @unique
  /// Why this reached adjudication: "escalated" or "consensus_disagreement".
  reason        String
  status        AdjudicationStatus @default(PENDING)
  /// The lead reviewer's binding decision, overriding earlier reviews.
  finalDecision ReviewDecision?
  notes         String?
  adjudicatedBy String?
  adjudicatedAt DateTime?
  createdAt     DateTime           @default(now())

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("adjudications")
}

model Review {
  id            String         @id @default(uuid())
  submissionId  String
  reviewerId    String
  decision      ReviewDecision
  feedback      String?
  severity      String?
  confidence    Float?
  createdAt     DateTime       @default(now())

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User           @relation("ReviewedBy", fields: [reviewerId], references: [id])
  scores     ReviewScore[]
  appeals    QualityAppeal[]

  @@index([submissionId])
  @@map("reviews")
}

model ReviewScore {
  id       String  @id @default(uuid())
  reviewId String
  rubricId String?
  category String
  score    Float

  review Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  rubric ReviewRubric? @relation(fields: [rubricId], references: [id])

  @@map("review_scores")
}

model QualityMetric {
  id        String   @id @default(uuid())
  trainerId String
  category  String
  score     Float
  recordedAt DateTime @default(now())

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("quality_metrics")
}

model QualitySnapshot {
  id                String   @id @default(uuid())
  trainerId         String
  overallScore       Float
  accuracy            Float?
  reviewerAgreement   Float?
  instructionFollowing Float?
  completionReliability Float?
  revisionRate         Float?
  rejectionRate         Float?
  avgTaskDurationSecs   Int?
  periodStart           DateTime
  periodEnd             DateTime

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("quality_snapshots")
}

/// Outcome of a hidden gold-standard task. Gold tasks are seeded invisibly
/// into a trainer's queue at a configured rate — this is the single most
/// reliable quality signal, because the trainer cannot tell it apart from
/// real work.
model GoldTaskResult {
  id           String   @id @default(uuid())
  goldTaskId   String
  userId       String
  submissionId String?
  passed       Boolean
  score        Float?
  evaluatedAt  DateTime @default(now())

  goldTask GoldTask @relation(fields: [goldTaskId], references: [id], onDelete: Cascade)

  @@index([userId, evaluatedAt])
  @@map("gold_task_results")
}

/// Agreement across trainers who independently completed the same task
/// (overlap/consensus review). Krippendorff's alpha is stored because it
/// tolerates multiple raters and missing ratings, unlike Cohen's kappa.
model ConsensusResult {
  id                 String   @id @default(uuid())
  taskId             String   @unique
  raterCount         Int
  krippendorffAlpha  Float?
  /// Fraction of raters agreeing with the majority label.
  majorityAgreement  Float?
  /// True when agreement fell below the project threshold and a lead
  /// reviewer must adjudicate.
  requiresAdjudication Boolean @default(false)
  computedAt         DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("consensus_results")
}

/// Tracks how closely a reviewer agrees with lead-reviewer adjudications.
/// Reviewers drift too — calibrating them is as important as calibrating
/// trainers, and is a common blind spot in review pipelines.
model ReviewerCalibration {
  id                 String   @id @default(uuid())
  reviewerId         String
  periodStart        DateTime
  periodEnd          DateTime
  reviewsCompleted   Int      @default(0)
  /// Agreement between this reviewer's decisions and lead adjudications.
  leadAgreementRate  Float?
  goldPassRate       Float?
  avgReviewSeconds   Int?

  @@index([reviewerId, periodEnd])
  @@map("reviewer_calibrations")
}

/// A trainer's appeal against a rejection or quality decision.
model QualityAppeal {
  id           String       @id @default(uuid())
  userId       String
  submissionId String?
  reviewId     String?
  reason       String
  status       AppealStatus @default(OPEN)
  decision     String?
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime     @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission TaskSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  review     Review?         @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("quality_appeals")
}

enum AppealStatus {
  OPEN
  UNDER_REVIEW
  UPHELD
  OVERTURNED
  WITHDRAWN
}

