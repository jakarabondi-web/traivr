enum RiskFlagStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

model RiskFlag {
  id        String         @id @default(uuid())
  userId    String
  signal    String
  severity  String
  status    RiskFlagStatus @default(OPEN)
  details   Json?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("risk_flags")
