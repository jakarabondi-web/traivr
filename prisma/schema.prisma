  createdAt      DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        DatasetItem[]
  exports      Export[]

  @@map("datasets")
}

model DatasetItem {
  id        String @id @default(uuid())
  datasetId String
  content   Json
  addedAt   DateTime @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@map("dataset_items")
}

enum ExportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

model Export {
  id        String       @id @default(uuid())
  datasetId String
  format    String       @default("jsonl")
  status    ExportStatus @default(QUEUED)
  fileUrl   String?
  /// The generated file itself. Kept in the row — not object storage —
  /// because this deployment has none; a dataset here is thousands of JSON
  /// rows at most, well within text-column territory. Snapshotted at
  /// processing time, so later dataset edits don't rewrite past exports.
  content   String?
  /// Human-readable failure reason when status is FAILED.
  error     String?
  requestedBy String
  createdAt DateTime     @default(now())
  completedAt DateTime?

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@map("exports")
}

