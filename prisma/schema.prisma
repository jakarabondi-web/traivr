// Traivr — core database schema
// See DATABASE.md for entity-relationship documentation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// Pooled connection. On serverless (Vercel) every invocation can open its
  /// own connection, which exhausts a Postgres connection limit long before
  /// it exhausts anything else — so this must point at a pooler (PgBouncer,
  /// Neon's pooled host, Supabase's :6543) in any deployed environment.
  url      = env("DATABASE_URL")
  /// Direct, unpooled connection. Migrations run DDL in a session that a
  /// transaction-mode pooler cannot carry, so they need the direct host.
  /// Locally both point at the same server, which is fine.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity, auth & RBAC
// ---------------------------------------------------------------------------

enum GlobalRole {
  TRAINER
  EXPERT
  REVIEWER
  LEAD_REVIEWER
  CLIENT_MEMBER
  CLIENT_ADMIN
  OPERATIONS_MANAGER
  QUALITY_MANAGER
  FINANCE_MANAGER
  SUPPORT_AGENT
  SUPER_ADMIN
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  emailVerifiedAt   DateTime?
  passwordHash      String?
  passwordResetToken String? @unique
  passwordResetExpiresAt DateTime?
  emailVerificationToken String? @unique
  emailVerificationExpiresAt DateTime?
  /// New address awaiting confirmation from a change-email request. `email`
  /// itself is left untouched (still the address used for login) until the
  /// verification link for this value is clicked — see verifyEmailToken().
  pendingEmail      String?
  firstName         String
  lastName          String
  displayName       String?
  avatarUrl         String?
  timezone          String?
  locale            String    @default("en")
  status            UserStatus @default(ACTIVE)
  twoFactorEnabled  Boolean   @default(false)
  /// AES-256-GCM ciphertext of the TOTP secret (iv:tag:ciphertext, base64).
  /// Never stored or logged in plaintext — see lib/security/field-encryption.ts.
  twoFactorSecret   String?
  /// SHA-256 hashes of one-time recovery codes. Each is removed on use, so a
  /// used code can never be replayed.
  twoFactorRecoveryCodes String[] @default([])
  lastLoginAt       DateTime?
  lastLoginIp       String?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  /// Bumped to invalidate every JWT session at once ("sign out everywhere").
  /// Sessions are stateless (JWT strategy, no server-side session store), so
  /// this is the only revocation lever available — checked on every request
  /// in the auth jwt() callback against the value embedded in the token.
  sessionVersion    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  accounts          Account[]
  sessions          Session[]
  loginEvents       LoginEvent[]
  ssoTickets        SsoTicket[]
  twoFactorChallenges TwoFactorChallenge[]
  roles             UserRole[]
  memberships       OrganizationMember[]
  trainerProfile    TrainerProfile?
  identityVerification IdentityVerification?
  application       Application?
  assessmentAttempts AssessmentAttempt[]
  readinessAttempts ReadinessAttempt[]
  projectApplications ProjectApplication[]
  taskAssignments   TaskAssignment[]
  submissions       TaskSubmission[]        @relation("SubmittedBy")
  reviewsGiven      Review[]                 @relation("ReviewedBy")
  earnings          Earning[]
  paymentAccounts   PaymentAccount[]
  payoutRequests    PayoutRequest[]
  supportTickets    SupportTicket[]          @relation("TicketRequester")
  assignedTickets   SupportTicket[]          @relation("TicketAssignee")
  supportMessages   SupportMessage[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  riskFlags         RiskFlag[]
  consentRecords    ConsentRecord[]
  locationSignals   LocationSignal[]
  apiKeys           ApiKey[]
  disputesFiled     Dispute[]
  qualityAppeals    QualityAppeal[]

  @@index([status])
  @@map("users")
}

/// Informational sign-in log — not the auth mechanism itself (sessions are
/// stateless JWTs). Exists purely so a user can see "where am I signed in,"
/// the same way any account-security page shows recent activity.
model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_events")
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

model Role {
  id          String       @id @default(uuid())
  key         GlobalRole   @unique
  name        String
  description String?
  permissions Permission[]  @relation("RolePermissions")
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String?
  roles       Role[] @relation("RolePermissions")

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// A single-use handoff from a completed SSO callback to the session layer.
///
/// The OIDC callback runs in a route handler, which cannot mint an Auth.js
/// session directly. Rather than trusting a user id carried in a URL, the
/// callback records a ticket here and the sign-in provider consumes it —
/// once, within a minute, and never again.
model SsoTicket {
  id             String   @id @default(uuid())
  token          String   @unique
  userId         String
  organizationId String
  issuer         String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sso_tickets")
}

/// A single-use handoff proving a 2FA (TOTP or recovery code) challenge was
/// satisfied, for the same reason SsoTicket exists: the code is checked in a
/// Server Action, which cannot mint an Auth.js session directly, and neither
/// a password-based nor an OAuth sign-in has anywhere else to carry a
/// second-factor result through to the session layer.
model TwoFactorChallenge {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_challenges")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ConsentRecord {
  id        String   @id @default(uuid())
  userId    String
  type      String
  version   String
  acceptedAt DateTime @default(now())
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consent_records")
}

// ---------------------------------------------------------------------------
// Organizations (client tenants) & multi-tenancy
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  TRIAL
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CLOSED
}

model Organization {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  website      String?
  industry     String?
  useCase      String?
  status       OrganizationStatus @default(TRIAL)
  securityTier String?
  /// Email domain that routes to this organization's SSO, e.g. "acme.com".
  /// Verified before enforcement so a tenant can't claim a domain it does
  /// not control.
  ssoDomain         String?  @unique
  ssoDomainVerifiedAt DateTime?
  /// Random value the tenant publishes as a DNS TXT record on the domain.
  /// Verification is a real DNS lookup, so a tenant cannot claim a domain
  /// it does not control.
  ssoDomainToken    String?
  /// Display name for the button on the sign-in page, e.g. "Okta".
  ssoProviderName   String?
  /// OIDC discovery URL and client id. The client secret is never stored
  /// here in plaintext — see SECURITY.md.
  ssoIssuerUrl      String?
  ssoClientId       String?
  ssoEnforced       Boolean  @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  members       OrganizationMember[]
  clientProfile ClientProfile?
  projects      Project[]
  billingAccount BillingAccount?
  invoices      Invoice[]
  datasets      Dataset[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  auditLogs     AuditLog[]

  @@map("organizations")
}

enum OrgMemberRole {
  MEMBER
  ADMIN
  BILLING_OWNER
}

model OrganizationMember {
  id             String        @id @default(uuid())
  organizationId String
  userId         String
  role           OrgMemberRole @default(MEMBER)
  invitedAt      DateTime      @default(now())
  joinedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model ClientProfile {
  id             String   @id @default(uuid())
  organizationId String   @unique
  contactName    String
  contactTitle   String?
  companySize    String?
  estimatedVolume String?
  onboardingStep Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

// ---------------------------------------------------------------------------
// Trainer profile & qualification
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  REJECTED
  WAITLISTED
  SUSPENDED
}

model TrainerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  headline            String?
  bio                 String?
  country             String?
  city                String?
  availableHoursPerWeek Int?
  qualityScore        Float?  @default(0)
  reliabilityScore     Float?  @default(0)
  onboardingStep       Int     @default(0)
  sensitiveContentOptIn Boolean @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  education      Education[]
  employment     Employment[]
  skills         UserSkill[]
  languages      UserLanguage[]
  paymentAccounts PaymentAccount[]
  qualityMetrics QualityMetric[]
  qualitySnapshots QualitySnapshot[]

  @@map("trainer_profiles")
}

model Education {
  id         String  @id @default(uuid())
  trainerId  String
  institution String
  degree      String?
  field       String?
  startYear   Int?
  endYear     Int?

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("education")
}

model Employment {
  id          String    @id @default(uuid())
  trainerId   String
  company     String
  title       String
  startDate   DateTime?
  endDate     DateTime?
  description String?

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("employment")
}

model Skill {
  id       String      @id @default(uuid())
  name     String      @unique
  category String?
  users    UserSkill[]
  readinessTasks ReadinessTask[]

  @@map("skills")
}

/**
 * A short calibration exercise in the mandatory post-approval Readiness
 * Program: a trainee judges a pair of candidate responses, then sees the
 * correct choice plus a guidance explanation immediately after submitting —
 * this teaches the platform's judgment standard rather than only testing it.
 * Scored per skill to build the trainer's UserSkill levels.
 */
model ReadinessTask {
  id           String   @id @default(uuid())
  skillId      String
  domain       String
  title        String
  prompt       String
  responseA    String
  responseB    String
  correctChoice String  // "A" | "B"
  guidance     String
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  skill    Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  attempts ReadinessAttempt[]

  @@map("readiness_tasks")
}

model ReadinessAttempt {
  id              String   @id @default(uuid())
  userId          String
  readinessTaskId String
  choice          String   // "A" | "B"
  correct         Boolean
  completedAt     DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  readinessTask ReadinessTask @relation(fields: [readinessTaskId], references: [id], onDelete: Cascade)

  @@unique([userId, readinessTaskId])
  @@index([userId])
  @@map("readiness_attempts")
}

model UserSkill {
  id        String @id @default(uuid())
  trainerId String
  skillId   String
  level     Int    @default(1)

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([trainerId, skillId])
  @@map("user_skills")
}

model Language {
  id    String         @id @default(uuid())
  code  String         @unique
  name  String
  users UserLanguage[]

  @@map("languages")
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

model UserLanguage {
  id          String              @id @default(uuid())
  trainerId   String
  languageId  String
  proficiency LanguageProficiency

  trainer  TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  language Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([trainerId, languageId])
  @@map("user_languages")
}

enum IdentityStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
}

enum VerificationCheckResult {
  PASS
  FAIL
  UNAVAILABLE
}

/// Identity verification outcome.
///
/// PRIVACY: we deliberately store only the provider's *decision* and an
/// opaque reference — never biometric templates, face embeddings, or
/// document images. Those stay inside the vendor's compliance envelope.
/// Storing them here would pull the platform into BIPA / GDPR Art. 9
/// obligations it is not built to carry. Do not add image or template
/// columns to this model. See SECURITY.md.
model IdentityVerification {
  id           String         @id @default(uuid())
  userId       String         @unique
  status       IdentityStatus @default(NOT_STARTED)
  provider     String?
  /// Opaque vendor-side verification id, for audit + support lookups.
  providerRef  String?
  documentType String?
  /// ISO country code read from the identity document by the provider.
  documentCountry String?

  // Individual check outcomes (decisions only).
  documentAuthentic     VerificationCheckResult?
  livenessPassed        VerificationCheckResult?
  faceMatchPassed       VerificationCheckResult?
  /// 1:N search against already-verified users — catches duplicate accounts.
  duplicateCheckPassed  VerificationCheckResult?
  /// Provider's own confidence in the 1:1 selfie↔document match.
  faceMatchScore        Float?

  /// Set when a human reviewed an inconclusive automated result.
  reviewedBy   String?
  reviewedAt   DateTime?
  attempts     Int            @default(0)
  submittedAt  DateTime?
  verifiedAt   DateTime?
  expiresAt    DateTime?
  notes        String?

  /// Uploaded ID photo + selfie for the in-house manual-review path
  /// (provider = "manual") — a free alternative when no vendor is
  /// configured. Bare FileAsset ids, not a formal relation, matching
  /// FileAsset.ownerId's own style. Deliberately temporary: cleared and the
  /// underlying objects deleted from storage once reviewVerification()
  /// records a decision — see SECURITY.md for why these two fields are the
  /// one exception to "decisions only, no images retained."
  documentAssetId String?
  selfieAssetId   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("identity_verifications")
}

// ---------------------------------------------------------------------------
// Work location & jurisdiction
// ---------------------------------------------------------------------------

enum LocationSignalSource {
  IP_GEOLOCATION
  DOCUMENT_COUNTRY
  DECLARED_COUNTRY
  TAX_RESIDENCY
}

/// A point-in-time observation of where a user appears to be working from.
///
/// PRIVACY: this is coarse (country/region/city from IP), not GPS tracking.
/// It exists to enforce per-project jurisdiction rules and detect account
/// sharing — not to monitor individuals. Retention is bounded; see
/// SECURITY.md before extending precision.
model LocationSignal {
  id          String               @id @default(uuid())
  userId      String
  source      LocationSignalSource
  countryCode String?
  region      String?
  city        String?
  /// Truncated/hashed at write time — never store a full raw client IP.
  ipHash      String?
  isVpn       Boolean              @default(false)
  isProxy     Boolean              @default(false)
  isDatacenter Boolean             @default(false)
  observedAt  DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, observedAt])
  @@map("location_signals")
}

enum JurisdictionRuleMode {
  ALLOW
  BLOCK
}

/// Project-level geofence: "workers on this project must be in X".
/// Enforced per project rather than by tracking people continuously.
model ProjectJurisdictionRule {
  id           String               @id @default(uuid())
  projectId    String
  mode         JurisdictionRuleMode @default(ALLOW)
  countryCode  String
  /// Why this restriction exists (data residency, language, contract term).
  reason       String?
  blockVpn     Boolean              @default(true)
  createdAt    DateTime             @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, countryCode])
  @@map("project_jurisdiction_rules")
}

/// A trainer's application to join the network. Gates access to paid work:
/// until status is APPROVED, the trainer can see their dashboard but no
/// assignments. See `canAccessAssignments` in lib/permissions/gating.ts.
model Application {
  id          String             @id @default(uuid())
  userId      String             @unique
  status      ApplicationStatus  @default(DRAFT)
  resumeUrl   String?
  /// Primary domain the applicant is applying to work in — selects which
  /// qualification assessment they're given.
  domain      String?
  submittedAt DateTime?
  decidedAt   DateTime?
  decidedBy   String?
  /// Shown to the applicant when more information is requested or the
  /// application is declined.
  reviewerMessage String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// Assessments
// ---------------------------------------------------------------------------

enum AssessmentAttemptStatus {
  AVAILABLE
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  PASSED
  FAILED
  EXPIRED
}

enum AssessmentStage {
  /// Short, low-stakes filter every applicant takes once, regardless of
  /// domain, before the real qualification exam unlocks.
  SCREENER
  /// The domain-specific exam that actually satisfies the trainer gate's
  /// "assessment passed" requirement.
  QUALIFICATION
}

model Assessment {
  id            String          @id @default(uuid())
  title         String
  domain        String
  description   String?
  stage         AssessmentStage @default(QUALIFICATION)
  timeLimitMins Int?
  passThreshold Float           @default(0.8)
  maxAttempts   Int             @default(2)
  cooldownHours Int             @default(72)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@map("assessments")
}

enum QuestionType {
  MULTIPLE_CHOICE
  WRITTEN_RESPONSE
  RANKING
  CODE
}

model AssessmentQuestion {
  id           String       @id @default(uuid())
  assessmentId String
  type         QuestionType
  prompt       String
  options      Json?
  correctAnswer Json?
  points       Int          @default(1)
  order        Int          @default(0)

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  responses  AssessmentResponse[]

  @@map("assessment_questions")
}

model AssessmentAttempt {
  id           String                   @id @default(uuid())
  assessmentId String
  userId       String
  status       AssessmentAttemptStatus  @default(AVAILABLE)
  score        Float?
  startedAt    DateTime?
  submittedAt  DateTime?
  expiresAt    DateTime?
  /// The random subset of the assessment's question bank drawn for this
  /// attempt. Fixed at start so a trainee can't retake for a fresh draw
  /// mid-attempt, and so the whole bank is never exposed to one attempt —
  /// a fixed set of questions gets shared/memorized quickly at any scale.
  selectedQuestionIds String[] @default([])

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses  AssessmentResponse[]

  @@index([userId])
  @@map("assessment_attempts")
}

model AssessmentResponse {
  id         String  @id @default(uuid())
  attemptId  String
  questionId String
  answer     Json
  isCorrect  Boolean?
  pointsAwarded Float?

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("assessment_responses")
}

// ---------------------------------------------------------------------------
// Projects, tasks & marketplace
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  PENDING_SETUP
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskType {
  SINGLE_RESPONSE_EVALUATION
  PAIRWISE_COMPARISON
  MULTI_RESPONSE_RANKING
  PROMPT_WRITING
  IDEAL_RESPONSE_WRITING
  RUBRIC_SCORING
  FACT_CHECKING
  CITATION_VERIFICATION
  SAFETY_CLASSIFICATION
  POLICY_CLASSIFICATION
  HALLUCINATION_DETECTION
  CODE_REVIEW
  CODE_OUTPUT_EVALUATION
  MULTI_TURN_EVALUATION
  /// Client-defined task shape. The project's TaskTemplate row carries the
  /// schema (see src/lib/tasks/custom-schema.ts): which payload fields the
  /// trainer is shown, and which response fields are collected.
  CUSTOM
}

model Project {
  id               String        @id @default(uuid())
  organizationId   String
  name             String
  description      String?
  domain           String
  taskType         TaskType
  status           ProjectStatus @default(DRAFT)
  payPerTaskCents  Int?
  estimatedHoursPerWeek Int?
  languages        String[]      @default([])
  positionsAvailable Int         @default(0)
  budgetCents      Int?
  qualityThreshold Float         @default(0.85)
  /// Fraction of a trainer's queue seeded with hidden gold tasks. 0.05-0.10
  /// is the usual range — high enough to calibrate, low enough not to waste
  /// paid capacity on work that is never delivered.
  goldTaskRate     Float         @default(0.07)
  /// How many trainers independently complete the same task, for consensus.
  /// 1 disables overlap.
  consensusOverlap Int           @default(1)
  securityLevel    String        @default("standard")
  containsSensitiveContent Boolean @default(false)
  startDate        DateTime?
  applicationDeadline DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  qualifications ProjectQualification[]
  applications  ProjectApplication[]
  assignments   ProjectAssignment[]
  taskTemplates TaskTemplate[]
  tasks         Task[]
  rubrics       ReviewRubric[]
  goldTasks     GoldTask[]
  datasets      Dataset[]
  jurisdictionRules ProjectJurisdictionRule[]
  invoiceLineItems InvoiceLineItem[]

  @@index([organizationId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("viewer")
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectQualification {
  id          String  @id @default(uuid())
  projectId   String
  description String
  required    Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_qualifications")
}

enum ProjectApplicationStatus {
  APPLIED
  MATCHED
  REJECTED
  WITHDRAWN
}

model ProjectApplication {
  id        String                    @id @default(uuid())
  projectId String
  userId    String
  status    ProjectApplicationStatus  @default(APPLIED)
  matchScore Float?
  appliedAt DateTime                  @default(now())
  decidedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_applications")
}

enum AssignmentStatus {
  ACTIVE
  PAUSED
  REMOVED
  COMPLETED
}

model ProjectAssignment {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  status    AssignmentStatus  @default(ACTIVE)
  assignedAt DateTime         @default(now())
  removedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_assignments")
}

model TaskTemplate {
  id        String   @id @default(uuid())
  projectId String
  name      String
  taskType  TaskType
  schema    Json
  instructions String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("task_templates")
}

enum TaskStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
  ESCALATED
}

model Task {
  id           String     @id @default(uuid())
  projectId    String
  templateId   String?
  externalRef  String?
  payload      Json
  status       TaskStatus @default(UNASSIGNED)
  isGold       Boolean    @default(false)
  priority     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template    TaskTemplate?    @relation(fields: [templateId], references: [id])
  assignments TaskAssignment[]
  submissions TaskSubmission[]
  goldTask    GoldTask?
  consensus   ConsensusResult?

  @@index([projectId, status])
  @@map("tasks")
}

model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
