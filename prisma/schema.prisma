model FileAsset {
  id         String   @id @default(uuid())
  ownerId    String?
  bucket     String
  key        String
  contentType String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  @@map("file_assets")
}

enum ApiKeyScope {
  READ
  WRITE
}

model ApiKey {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  name           String
  /// SHA-256 of the secret. The plaintext key is shown once at creation and
  /// never stored — there is no way to recover it, only to revoke and reissue.
  hashedKey      String   @unique
  /// Non-secret leading segment (e.g. "tra_live_9f3a") so a key can be
  /// identified in the UI and in logs without revealing it.
  prefix         String   @default("")
  /// READ alone cannot mutate. Scope is checked per route, server-side.
  scopes         ApiKeyScope[] @default([READ])
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Webhook {
  id             String   @id @default(uuid())
  organizationId String
  url            String
  secret         String
  events         String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}
